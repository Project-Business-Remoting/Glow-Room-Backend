{
  "name": "glow-room-backend",
  "version": "1.0.0",
  "description": "Backend API pour Glow Room Hair — réservations Firebase, emails Interac",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.0",
    "firebase-admin": "^12.2.0",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.2.2"
  }
}
